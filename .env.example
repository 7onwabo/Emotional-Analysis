# Copy to .env and fill in. .env is gitignored.

# HuggingFace
HF_TOKEN=
HF_HOME=./.cache/huggingface

# Weights & Biases (optional experiment tracking)
WANDB_API_KEY=
WANDB_PROJECT=cos760-emotion-analysis
WANDB_ENTITY=

# Compute
CUDA_VISIBLE_DEVICES=0
TOKENIZERS_PARALLELISM=false

# Paths
DATA_DIR=./data
OUTPUT_DIR=./outputs
LOG_DIR=./logs
